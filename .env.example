# Vercel Production and Preview variables for https://heerlenrp.nl
# Set secret values in Vercel > Project > Settings > Environment Variables.
PUBLIC_ORIGIN=https://heerlenrp.nl
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Required persistent CMS storage. Use your Neon pooled PostgreSQL connection string.
DATABASE_URL=

# Optional alternative to DATABASE_URL: private Vercel Blob storage.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Discord OAuth2 and role verification.
DISCORD_CLIENT_ID=1568045420788056245
DISCORD_CLIENT_SECRET=ADD_ROTATED_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://heerlenrp.nl/api/auth/callback
DISCORD_GUILD_ID=1564673971587387452
DISCORD_BOT_TOKEN=ADD_ROTATED_DISCORD_BOT_TOKEN
DISCORD_ADMIN_ROLE_ID=1568033014384951366
DISCORD_STAFF_ROLE_ID=1567581357004038184

# Vercel supplies VERCEL and VERCEL_OIDC_TOKEN automatically when applicable.
# Do not set PORT or CONTENT_STORE_PATH on Vercel.
