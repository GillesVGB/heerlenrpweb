# Vercel Production and Preview variables for https://www.heerlenrp.nl
# Set secret values in Vercel > Project > Settings > Environment Variables.
PUBLIC_ORIGIN=https://www.heerlenrp.nl
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Required persistent CMS storage. For Supabase REST, set both values below.
# Keep the service role key server-side; never expose it to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alternative PostgreSQL provider: Neon pooled connection string.
DATABASE_URL=

# Optional alternative when no database is configured: private Vercel Blob storage.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Discord OAuth2 and role verification.
DISCORD_CLIENT_ID=1568045420788056245
DISCORD_CLIENT_SECRET=ADD_ROTATED_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://www.heerlenrp.nl/api/auth/callback
DISCORD_GUILD_ID=1564673971587387452
DISCORD_BOT_TOKEN=ADD_ROTATED_DISCORD_BOT_TOKEN
DISCORD_ADMIN_ROLE_ID=1568033014384951366
DISCORD_STAFF_ROLE_ID=1567581357004038184
# Optional least-privilege community-management roles; unset roles receive no extra permissions.
DISCORD_EVENTS_ROLE_ID=
DISCORD_JOBS_ROLE_ID=
DISCORD_FORMS_ROLE_ID=
DISCORD_APPLICATIONS_READ_ROLE_ID=
DISCORD_APPLICATIONS_REVIEW_ROLE_ID=
DISCORD_HELP_ROLE_ID=
DISCORD_COMMENTS_ROLE_ID=
DISCORD_ACHIEVEMENTS_ROLE_ID=
DISCORD_PROFILES_ROLE_ID=
DISCORD_NOTIFICATIONS_ROLE_ID=

# Optional FiveM status configuration. Leave FIVEM_SERVER_HOST empty to use CFX listing/join-code lookup.
FIVEM_SERVER_HOST=
FIVEM_SERVER_PORT=30120
CFX_JOIN_CODE=j48ry5k

# Vercel supplies VERCEL and VERCEL_OIDC_TOKEN automatically when applicable.
# Do not set PORT or CONTENT_STORE_PATH on Vercel.

# Optional Tebex private Checkout API key for the all-time top donor.
# Keep this server-side; never add it to site settings or browser code.
TEBEX_CHECKOUT_API_KEY=
